# Image generation provider.
# If GEMINI_API_KEY is unset, /api/generate returns a labelled DEMO placeholder
# so the full flow still works without a key.

# Google Gemini image generation ("nano-banana"). image+image -> image.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash-image)
IMAGE_MODEL=gemini-2.5-flash-image
